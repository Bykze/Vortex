{
  "name": "vortex-school-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix api run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix api run start",
    "db:migrate": "node api/src/db/migrate.js",
    "db:seed": "node db/seed/index.js",
    "db:test:isolation": "node db/seed/test-isolation.js",
    "install:all": "npm --prefix api install && npm --prefix web install"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
