# PostgreSQL connection string
DATABASE_URL=postgres://vortex_app:change_me@localhost:5432/vortex

# JWT secrets
JWT_ACCESS_SECRET=change_this_to_a_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_another_random_string_32_chars

# JWT expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# API server
API_PORT=4000
API_HOST=0.0.0.0

# Web (Vite) — API URL for the frontend
VITE_API_URL=http://localhost:4000

# Bcrypt rounds
BCRYPT_ROUNDS=10
